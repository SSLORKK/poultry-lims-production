# Database Configuration
# The DATABASE_URL is automatically provided by Replit's PostgreSQL database
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://user:password@localhost:5432/lims_db

# Application Settings
PROJECT_NAME=LIMS API
VERSION=1.0.0
API_V1_STR=/api/v1

# Environment (development/production)
# IMPORTANT: Set to "production" in production environments!
ENVIRONMENT=development

# Security Configuration
# IMPORTANT: Generate a secure key for production!
# Run: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256

# Token Expiration Settings
# Access tokens are short-lived (minutes), refresh tokens are long-lived (days)
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
REMEMBER_ME_EXPIRE_DAYS=30

# CORS - Allowed Origins (comma-separated)
# Add your production domain(s) here
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5000

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
LOGIN_RATE_LIMIT=5/minute

# Account Lockout (Brute Force Protection)
# Account locks after MAX_LOGIN_ATTEMPTS failed attempts for LOCKOUT_DURATION_MINUTES
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
